
import pygame
pygame.init()

WIDTH = 6380
HEIGHT = 5750
window = pygame.display.set_mode((WIDTH, HEIGHT))
pygame.display.set_caption("Camera com Zoom")
clock = pygame.time.Clock()

mapa = pygame.image.load('assets/mapa.png').convert()
map_width = mapa.get_width()
map_height = mapa.get_height()

zoom = 2
camera_width = WIDTH // zoom
camera_height = HEIGHT // zoom
camera_surface = pygame.Surface((camera_width, camera_height))

player_x = 300
player_y = 300
player_speed = 5
player_size = 40

game = True

while game:
    
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            game = False
    
    keys = pygame.key.get_pressed()
    if keys[pygame.K_a]:
        player_x -= player_speed
    if keys[pygame.K_d]:
        player_x += player_speed
    if keys[pygame.K_w]:
        player_y -= player_speed
    if keys[pygame.K_s]:
        player_y += player_speed

    camera_x = player_x - camera_width // 2
    camera_y = player_y - camera_height // 2

    camera_x = max(0, min(camera_x, map_width - camera_width))
    camera_y = max(0, min(camera_y, map_height - camera_height))

    camera_surface.fill((0, 0, 0))  
    camera_surface.blit(mapa, (-camera_x, -camera_y))

    pygame.draw.rect(camera_surface,(255, 0, 0),(player_x - camera_x,player_y - camera_y,player_size,player_size))

    zoomed_surface = pygame.transform.scale(camera_surface,(WIDTH, HEIGHT))

    window.blit(zoomed_surface, (0, 0))

    pygame.display.update()  
    clock.tick(60)
pygame.quit()  
